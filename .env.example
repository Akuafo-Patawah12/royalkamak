# Copy to .env.local and fill in.

# Kamakz backend (JAX-RS root, without the trailing /api/...)
# Local WildFly: http://localhost:8080/kamakz/webresources
# Production:    https://kamakz.com/kamakz/webresources
KAMAK_API_URL=http://localhost:8080/kamakz/webresources

# companyID of the Royal Kamak company in Kamakz (company table)
ROYALKAMAK_COMPANY_ID=1

# ISO currency code used to display prices
ROYALKAMAK_CURRENCY=GHS
